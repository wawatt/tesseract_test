<?xml version="1.0" ?>
<!--
  VAMP Spherized Collision Model for Fanuc R-2000iC/165F
  Generated via CoMMALab/foam (Medial Axis Transform) directly from high-resolution visual DAE meshes.
  - Visual: High-fidelity CAD meshes for 3D GUI / RViz visualization.
  - Collision: Optimal Medial Axis spheres directly computed from visual surface geometry.
-->
<robot name="r2000ic_165f" xmlns:tesseract="https://github.com/tesseract-robotics/tesseract" tesseract:make_convex="true">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/r2000ic_165f/visual/base.dae" />
      </geometry>
    </visual>
    <!-- FOAM Spheres from base.dae -->
    <collision name="base_s0">
      <origin xyz="-0.3132 0.0030 0.1198" rpy="0 0 0" />
      <geometry><sphere radius="0.3642" /></geometry>
    </collision>
    <collision name="base_s1">
      <origin xyz="0.0817 0.1050 0.1292" rpy="0 0 0" />
      <geometry><sphere radius="0.3609" /></geometry>
